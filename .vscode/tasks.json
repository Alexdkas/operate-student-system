{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build project",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "mkdir -p \"${workspaceFolder}/bin\" && g++ -std=c++17 -g \"${workspaceFolder}/src\"/*.cpp -I\"${workspaceFolder}/include\" -o \"${workspaceFolder}/bin/main\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}